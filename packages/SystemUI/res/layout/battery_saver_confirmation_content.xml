<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/standard_option_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical">

        <RadioButton
            android:id="@+id/standard_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@null"
            android:checked="true"
            android:clickable="false"
            android:focusable="false"
            android:padding="8dp" />

        <TextView
            android:id="@+id/standard_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:layout_toEndOf="@id/standard_button"
            android:text="@string/saver_confirmation_dialog_title_standard_mode"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/materialColorOnSurface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/standard_title"
            android:layout_toEndOf="@id/standard_button"
            android:text="@string/saver_confirmation_dialog_summary_standard_mode"
            android:textAppearance="?android:attr/textAppearanceListItemSecondary"
            android:textColor="@color/materialColorOnSurfaceVariant" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/extreme_option_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical">

        <RadioButton
            android:id="@+id/extreme_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@null"
            android:clickable="false"
            android:focusable="false"
            android:padding="8dp" />

        <TextView
            android:id="@+id/extreme_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:layout_toEndOf="@id/extreme_button"
            android:text="@string/saver_confirmation_dialog_title_extreme_mode"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/materialColorOnSurface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/extreme_title"
            android:layout_toEndOf="@id/extreme_button"
            android:text="@string/saver_confirmation_dialog_summary_extreme_mode"
            android:textAppearance="?android:attr/textAppearanceListItemSecondary"
            android:textColor="@color/materialColorOnSurfaceVariant" />
    </RelativeLayout>

    <Button
        android:id="@+id/setup_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/battery_saver_dialog_chip_background"
        android:lineHeight="20sp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="@string/saver_confirmation_dialog_setup_text"
        android:textColor="@color/materialColorOnSurface"
        android:textSize="14sp" />
</LinearLayout>
